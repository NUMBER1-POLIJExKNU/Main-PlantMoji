# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real keys.

# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable key (sb_publishable_...) — safe for the browser, read-only via RLS.
# (Legacy "anon" key also works here if your project still uses the old keys.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Secret key (sb_secret_...) — SERVER ONLY. Never expose to the browser.
# (Legacy "service_role" key also works here.)
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# Optional shared token for POST /api/device-events.
# If set, Node-RED must send header:  Authorization: Bearer <this value>
# If unset, the endpoint accepts requests without auth (local prototype mode).
DEVICE_API_TOKEN=

# Optional presentation cheat code used only by Settings → Demo Control Center.
# The same code can reset progress or unlock the full Lv.10 showcase.
# Set 8+ characters. It is checked server-side and never exposed to the browser.
DEMO_CHEAT_CODE=

# Optional BMKG village-level forecast code. Defaults to Tegalgede,
# Sumbersari, Jember (35.09.21.1005), the POLIJE area used by this demo.
BMKG_ADM4_CODE=35.09.21.1005

# Optional — enables the AI personality layer (language only, handoff §24).
# When unset or when any AI call fails, the game always falls back to the
# deterministic personality templates. SERVER ONLY.
ANTHROPIC_API_KEY=
